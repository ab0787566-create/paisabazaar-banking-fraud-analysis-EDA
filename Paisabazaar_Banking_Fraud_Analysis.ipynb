   "source": [
    "# Shared helper used by the individual chart cells.\n",
    "def finish_chart(title, xlabel=None, ylabel=None, rotate_x=0):\n",
    "    \"\"\"Apply consistent labels and layout to the current Matplotlib chart.\"\"\"\n",
    "    plt.title(title)\n",
    "    if xlabel is not None:\n",
    "        plt.xlabel(xlabel)\n",
    "    if ylabel is not None:\n",
    "        plt.ylabel(ylabel)\n",
    "    if rotate_x:\n",
    "        plt.xticks(rotation=rotate_x, ha=\"right\")\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "# Exclude identifier-like fields from numerical analysis.\n",
    "identifier_set = {\"ID\", \"Customer_ID\", \"Name\", \"SSN\"}\n",
    "numeric_features = [c for c in analysis_df.select_dtypes(include=np.number).columns if c not in identifier_set]"
   ]
  },
