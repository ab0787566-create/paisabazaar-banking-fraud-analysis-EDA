   "source": [
    "# Locate dataset.csv in the current folder or common notebook upload locations.\n",
    "# If running in Google Colab and the file is not present, prompt for an upload.\n",
    "candidate_paths = [Path(\"dataset.csv\"), Path(\"/content/dataset.csv\"), Path(\"/mnt/data/dataset.csv\")]\n",
    "DATA_PATH = next((path for path in candidate_paths if path.exists()), None)\n",
    "\n",
    "if DATA_PATH is None:\n",
    "    try:\n",
    "        from google.colab import files\n",
    "        uploaded = files.upload()\n",
    "        csv_names = [name for name in uploaded if name.lower().endswith(\".csv\")]\n",
    "        if not csv_names:\n",
    "            raise FileNotFoundError(\"Please upload the dataset CSV file.\")\n",
    "        DATA_PATH = Path(csv_names[0])\n",
    "    except ImportError as exc:\n",
    "        raise FileNotFoundError(\n",
    "            \"dataset.csv was not found. Place it beside the notebook or upload it in Google Colab.\"\n",
    "        ) from exc\n",
    "\n",
    "raw_df = pd.read_csv(DATA_PATH)\n",
    "df = raw_df.copy()\n",
    "\n",
    "# Trim surrounding whitespace from text columns without changing category meaning.\n",
    "text_columns = df.select_dtypes(include=[\"object\", \"string\"]).columns\n",
    "df[text_columns] = df[text_columns].apply(lambda column: column.astype(\"string\").str.strip())\n",
    "\n",
    "print(f\"Loaded file: {DATA_PATH}\")\n",
    "print(f\"Dataset shape: {df.shape[0]:,} rows × {df.shape[1]} columns\")\n",
    "display(df.head())"
   ]
